{
  "name": "pelorus-client",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/app.js --sourcemap --target=es2022 --format=esm",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/app.js --sourcemap --target=es2022 --format=esm --watch",
    "clean": "rm -rf dist/*.js dist/*.map"
  },
  "dependencies": {
    "apache-arrow": "^18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
